# 楽天API
RAKUTEN_APP_ID=your_application_id
RAKUTEN_ACCESS_KEY=your_access_key
RAKUTEN_AFFILIATE_ID=your_affiliate_id
# 楽天アフィリエイトに登録した運営サイトのURL（HTTPヘッダーとして送信）
RAKUTEN_REFERER=https://example.com/
RAKUTEN_ORIGIN=https://example.com

# PostgreSQL（compose.yaml から参照。DATABASE_URL と値を一致させる）
DATABASE_USER=affiliate
DATABASE_PASSWORD=change_this_password
DATABASE_NAME=affiliate
# VPS/DockerではPostgreSQLのサービス名 db をホスト名にする。
DATABASE_URL=postgresql://affiliate:change_this_password@db:5432/affiliate?client_encoding=UTF8

# WordPress（利用する場合）
WORDPRESS_URL=https://example.com
WORDPRESS_USER=your_wordpress_username
WORDPRESS_APP_PASSWORD=your_wordpress_application_password
